%These commands expect xspace package, if not in class, uncomment here.
%\RequirePackage{xspace}

% Help with annoying, but often used text snippets
\newcommand{\ie}{i.\,e.\xspace}
\newcommand{\Ie}{I.\,e.\xspace}
\newcommand{\eg}{e.\,g.\xspace}
\newcommand{\Eg}{E.\,g.\xspace}

\newcommand{\ts}{\lstinline!YYYY-MM-DDTHH:mm:ss.SSS!\xspace}

% Anything squared
\newcommand*\sq{$^2$}
% Shortcut to text superscript
\newcommand{\tsup}{\textsuperscript}
% Shortcut to text subscript
\newcommand{\tsub}{\textsubscript}


% Deal with fractions
\newcommand\sfrac[2]{#1/#2\xspace}
% Inches
\newcommand{\inches}{\ensuremath{{}^{\prime\prime}}\xspace}